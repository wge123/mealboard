#!/bin/sh
# This repo sets core.hooksPath=.githooks, which OVERRIDES the global hooksPath
# entirely, so the machine-wide post-merge never fires here. This shim calls it.
# Same shim as dotfiles' and second_brain's.
set -u

global="$HOME/.claude/githooks/post-merge"
[ -x "$global" ] && exec "$global" "$@"

exit 0
