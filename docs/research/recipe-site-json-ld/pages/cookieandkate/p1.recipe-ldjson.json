{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/cookieandkate.com\/lentil-curry\/#article","isPartOf":{"@id":"https:\/\/cookieandkate.com\/lentil-curry\/"},"author":{"name":"Kathryne Taylor","@id":"https:\/\/cookieandkate.com\/#\/schema\/person\/c609c24a34a1976d0a3c1a1b0cd7f46a"},"headline":"Lentil Curry","datePublished":"2026-10-14T21:56:27+00:00","dateModified":"2026-10-14T21:56:30+00:00","wordCount":578,"commentCount":13,"publisher":{"@id":"https:\/\/cookieandkate.com\/#organization"},"image":{"@id":"https:\/\/cookieandkate.com\/lentil-curry\/#primaryimage"},"thumbnailUrl":"https:\/\/cookieandkate.com\/images\/2026\/10\/lentil-curry-scaled.jpg","keywords":["bell peppers","carrots","cauliflower","coconut milk","lentils","potatoes"],"articleSection":["dairy free","egg free","fall","gluten free","Indian","main dishes","nut free","pack for lunch","recipes","soups and stews","soy free","vegan","winter"],"inLanguage":"en-US","potentialAction":[{"@type":"CommentAction","name":"Comment","target":["https:\/\/cookieandkate.com\/lentil-curry\/#respond"]}]},{"@type":"WebPage","@id":"https:\/\/cookieandkate.com\/lentil-curry\/","url":"https:\/\/cookieandkate.com\/lentil-curry\/","name":"Lentil Curry - Cookie and Kate","isPartOf":{"@id":"https:\/\/cookieandkate.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/cookieandkate.com\/lentil-curry\/#primaryimage"},"image":{"@id":"https:\/\/cookieandkate.com\/lentil-curry\/#primaryimage"},"thumbnailUrl":"https:\/\/cookieandkate.com\/images\/2026\/10\/lentil-curry-scaled.jpg","datePublished":"2026-10-14T21:56:27+00:00","dateModified":"2026-10-14T21:56:30+00:00","description":"This lentil curry recipe offers fresh flavor, warming spices and vegetables. Inspired by Indian curries, this recipe is satisfying and delicious!","breadcrumb":{"@id":"https:\/\/cookieandkate.com\/lentil-curry\/#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/cookieandkate.com\/